# Copy this file to secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit it.
#
# On Streamlit Cloud set these under: App settings → Secrets

# ── Backend ───────────────────────────────────────────────────────────────────
BASE_URL  = "https://f-o-withbreezeapi.onrender.com"
APP_TOKEN = "your-app-token-here"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate these values by running:
#   python streamlit_app/generate_password_hash.py
AUTH_USERNAME      = "admin"
AUTH_SALT          = "your-random-salt-here"
AUTH_PASSWORD_HASH = "your-sha256-hash-here"
